# Copy to .env and fill in. Never commit .env.
ANTHROPIC_API_KEY=sk-ant-...
# Signed organizer URL without the group_id parameter (the app appends &group_id=...)
ORGANIZER_API_URL=https://....api.powerplatform.com/powerautomate/automations/direct/cu/11/workflows/.../triggers/manual/paths/invoke?api-version=1&sp=%2Ftriggers%2Fmanual%2Frun&sv=1.0&sig=...
# Optional. Default is a SQLite file in api/data/. Postgres example: postgresql+psycopg://user:pass@host:5432/cqa
# DATABASE_URL=
DEFAULT_PROVIDER=anthropic
DEFAULT_MODEL=claude-opus-5-5
SECONDARY_MODEL=claude-sonnet-5-5
# Optional local model through an OpenAI-compatible endpoint (vLLM / Ollama)
# LOCAL_ENDPOINT=http://localhost:11434/v1
# LOCAL_MODEL=qwen3:8b
EXPLANATION_LANGUAGE=ru
PII_MASKING=true
